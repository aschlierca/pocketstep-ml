# Private planning documents
doc/spec/PRD.md

# Session data in ml/data/raw/ is published (see README "Privacy and research ethics").
# Exported ZIPs and videos are never committed.
ml/data/processed/*
!ml/data/processed/.gitkeep
*.zip
*.mov
*.mp4

# Local pipeline outputs. The published model and reports live in ml/published/ and are
# committed by the retrain workflow.
ml/models/*
!ml/models/.gitkeep
ml/reports/*
!ml/reports/.gitkeep

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Xcode (per-researcher signing settings are written by ios/setup_signing.sh)
ios/Config/Signing.xcconfig
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/build/
DerivedData/

# OS / editor
.DS_Store
.vscode/
.idea/
